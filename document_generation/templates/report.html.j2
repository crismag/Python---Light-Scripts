<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ report.title }}</title>
  <link rel="stylesheet" href="report.css" />
</head>
<body>
<div class="page-wrapper">

  <!-- Header -->
  <header class="report-header">
    <h1>{{ report.title }}</h1>
    {% if report.subtitle %}<p class="subtitle">{{ report.subtitle }}</p>{% endif %}
    <table class="meta-table">
      <tr><th>Date</th><td>{{ report.date }}</td></tr>
      <tr><th>Authors</th><td>{{ report.authors | map(attribute='name') | join(', ') }}</td></tr>
      {% if report.confidentiality %}
      <tr><th>Confidentiality</th><td class="confidential">{{ report.confidentiality }}</td></tr>
      {% endif %}
    </table>
  </header>

  <!-- Table of Contents -->
  <nav class="toc">
    <h2>Table of Contents</h2>
    <ol>
      {% for section in sections %}
      <li><a href="#section-{{ loop.index }}">{{ section.title }}</a></li>
      {% endfor %}
    </ol>
  </nav>

  <!-- Sections -->
  <main>
    {% for section in sections %}
    <section id="section-{{ loop.index }}" class="report-section{% if section.highlight is defined and section.highlight %} highlight-section{% endif %}">
      <h2>{{ section.title }}</h2>
      <p>{{ section.content | trim | replace('\n', '<br>') }}</p>

      {% if section.metrics is defined %}
      <h3>Key Metrics</h3>
      <table class="data-table">
        <thead><tr><th>Metric</th><th>Value</th></tr></thead>
        <tbody>
          {% for m in section.metrics %}
          <tr><td>{{ m.label }}</td><td class="value-cell">{{ m.value }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if section.incidents is defined %}
      <h3>Incidents</h3>
      <table class="data-table">
        <thead><tr><th>ID</th><th>Severity</th><th>Date</th><th>Resolution (hrs)</th></tr></thead>
        <tbody>
          {% for i in section.incidents %}
          <tr>
            <td>{{ i.id }}</td>
            <td class="severity-{{ i.severity | lower | replace('-', '') }}">{{ i.severity }}</td>
            <td>{{ i.date }}</td>
            <td>{{ i.resolution_hrs }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if section.action_items is defined %}
      <h3>Action Items</h3>
      <table class="data-table">
        <thead><tr><th>Owner</th><th>Due Date</th><th>Task</th></tr></thead>
        <tbody>
          {% for a in section.action_items %}
          <tr><td>{{ a.owner }}</td><td>{{ a.due }}</td><td>{{ a.task }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </section>
    {% endfor %}
  </main>

  <footer class="report-footer">
    <p>Generated by <code>html_report.py</code> &mdash; Python Light Scripts</p>
  </footer>

</div>
</body>
</html>
